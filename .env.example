# Point at a backend to deliver contact enquiries for real.
# Without it, the form validates and resolves locally so the UX still works.
VITE_API_URL=

# Optional: a cached Instagram feed endpoint for the "FOLLOW THE MACHINE"
# section. The site never scrapes Instagram from the browser — supply a
# server-side endpoint that returns the shape in src/data/social.ts.
VITE_SOCIAL_FEED_URL=
